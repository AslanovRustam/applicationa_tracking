# Google Sheets (служебный аккаунт) — один из двух вариантов:
#   локально: путь к скачанному JSON-ключу
GOOGLE_SERVICE_ACCOUNT_FILE=
#   на Vercel: содержимое JSON-ключа (вставьте файл целиком в поле значения)
# GOOGLE_SERVICE_ACCOUNT_JSON=
# ID новой таблицы, с которой работает приложение
SPREADSHEET_ID=

# Auth.js + Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
# Единственный email, которому разрешён вход
ALLOWED_EMAIL=

# Локальная разработка без Google (игнорируется в production)
# SHEETS_DRIVER=memory
# AUTH_DISABLED=true

# Перенос старых данных (только чтение старой таблицы)
OLD_SPREADSHEET_ID=
OLD_SHEET_TAB=отклики
